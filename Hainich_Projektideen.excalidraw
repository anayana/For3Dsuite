  },
  {
   "id": "t_4k",
   "type": "text",
   "x": 634,
   "y": 2719,
   "width": 559.5200000000001,
   "height": 440,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
