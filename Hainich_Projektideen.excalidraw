  },
  {
   "id": "t_6t",
   "type": "text",
   "x": 1244,
   "y": 4547.5,
   "width": 559.5200000000001,
   "height": 600,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
