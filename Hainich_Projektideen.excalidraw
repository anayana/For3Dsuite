   ],
   "frameId": "f_2z",
   "roundness": null,
   "seed": 1112,
   "version": 1,
   "versionNonce": 7794,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764000000000,
   "link": null,
   "locked": false,
   "text": "Frage: Wo bleibt es im Sommer kühl und feucht, wo nicht?\n\nDaten: Mikroklima-Sensoren, ALS (Kronendichte, Lücken),\nSatellit\n\nVorgehen: Sensorwerte gegen die Struktur modellieren und auf\ndie Fläche hochrechnen\n\nErgebnis: Karte der Temperaturpufferung, Hitzeinseln in Lücken\n\nNutzen: Lebensraum für Arten, Erholung, Argument für\ngeschlossene Altbestände\n\nVertiefung:\n• Pufferung: Unterschied zwischen Wald und Freiland an heißen\nTagen.\n• Lücken: Junge und alte Lücken vergleichen.\n• Arten: Eingangsgröße für die Habitatkarten.\n\nHängt zusammen mit: Biodiversität auf die Fläche,\nWasserhaushalt, Verjüngung und Lückendynamik",
   "originalText": "Frage: Wo bleibt es im Sommer kühl und feucht, wo nicht?\n\nDaten: Mikroklima-Sensoren, ALS (Kronendichte, Lücken),\nSatellit\n\nVorgehen: Sensorwerte gegen die Struktur modellieren und auf\ndie Fläche hochrechnen\n\nErgebnis: Karte der Temperaturpufferung, Hitzeinseln in Lücken\n\nNutzen: Lebensraum für Arten, Erholung, Argument für\ngeschlossene Altbestände\n\nVertiefung:\n• Pufferung: Unterschied zwischen Wald und Freiland an heißen\nTagen.\n• Lücken: Junge und alte Lücken vergleichen.\n• Arten: Eingangsgröße für die Habitatkarten.\n\nHängt zusammen mit: Biodiversität auf die Fläche,\nWasserhaushalt, Verjüngung und Lückendynamik",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
