   "text": "12–15 gefällte Buchen ab 55 cm, vorher unbelaubt mit\nTLS gescannt.",
   "originalText": "12–15 gefällte Buchen ab 55 cm, vorher unbelaubt mit\nTLS gescannt.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t_3c",
   "type": "text",
   "x": 634,
   "y": 1537.5,
   "width": 559.5200000000001,
   "height": 680,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
