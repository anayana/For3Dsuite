  {
   "id": "t_3j",
   "type": "text",
   "x": 1244,
   "y": 1515,
   "width": 541.6,
   "height": 540,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
