   "locked": false,
   "text": "Wie stark puffert das Kronendach Hitze?",
   "originalText": "Wie stark puffert das Kronendach Hitze?",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "id": "t_3x",
   "type": "text",
   "x": 2464,
   "y": 1515,
   "width": 559.5200000000001,
   "height": 420,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
